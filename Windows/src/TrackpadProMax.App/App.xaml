<Application x:Class="TrackpadProMax.App.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" ShutdownMode="OnExplicitShutdown">
 <Application.Resources>
  <SolidColorBrush x:Key="PanelBrush" Color="#171E2D"/>
  <Style TargetType="Window"><Setter Property="Background" Value="#0C111C"/><Setter Property="Foreground" Value="#EAF0FC"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="14"/></Style>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#DDE5F6"/></Style>
  <Style TargetType="Button"><Setter Property="Foreground" Value="#EAF0FC"/><Setter Property="Background" Value="#24344C"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="16,10"/><Setter Property="Margin" Value="0,0,10,10"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#345879"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="Background" Value="#3B688D"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#101827"/><Setter Property="Foreground" Value="#E2EBFA"/><Setter Property="CaretBrush" Value="White"/><Setter Property="BorderBrush" Value="#33445E"/><Setter Property="Padding" Value="10"/><Setter Property="Margin" Value="0,4,0,12"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#DFE8FA"/><Setter Property="Margin" Value="0,8,0,12"/></Style>
  <Style TargetType="DataGrid"><Setter Property="Background" Value="#131B29"/><Setter Property="Foreground" Value="#E2EBFA"/><Setter Property="RowBackground" Value="#172131"/><Setter Property="AlternatingRowBackground" Value="#1C293C"/><Setter Property="GridLinesVisibility" Value="None"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="BorderThickness" Value="0"/><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="RowHeight" Value="40"/></Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#293B55"/><Setter Property="Foreground" Value="White"/><Setter Property="Padding" Value="10"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style TargetType="DataGridCell"><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="5"/></Style>
  <Style TargetType="ComboBox"><Style.Resources><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#101827"/></Style></Style.Resources><Setter Property="Margin" Value="0,4,12,12"/><Setter Property="Padding" Value="8"/><Setter Property="Foreground" Value="#101827"/></Style>
 </Application.Resources>
</Application>
